# انسخ هذا الملف إلى .env وضع القيم الحقيقية — لا تضع الأسرار في المستودع

# توكن البوت من @BotFather في Telegram
BOT_TOKEN=ضع_التوكن_هنا

# معرفات الأدمن (Telegram ID) — يمكن فصلها بفواصل
ADMIN_IDS=123456789

# مسار قاعدة البيانات SQLite (اختياري — الافتراضي data/price_tracker.db)
DB_PATH=data/price_tracker.db

# فترة فحص الأسعار بالساعات (اختياري — الافتراضي 6)
CHECK_INTERVAL_HOURS=6

# مستوى التسجيل (INFO / DEBUG / WARNING)
LOG_LEVEL=INFO

# المنطقة الزمنية
TIMEZONE=Africa/Cairo

# وضع Webhook — للتشغيل المحلي اتركه false.
# عند النشر على Render يُفعل تلقائيًا عبر RENDER_EXTERNAL_URL،
# أو فعّله يدويًا مع WEBHOOK_BASE_URL = رابط الخدمة مثل https://my-bot.onrender.com
USE_WEBHOOK=false
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# إعدادات الشبكة
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=2
